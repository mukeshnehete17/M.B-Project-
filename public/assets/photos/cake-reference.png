<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="100%" height="100%">
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#FFF5E4" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#F2BED1" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="cake1" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFF0F5"/>
      <stop offset="100%" stop-color="#FDCEDF"/>
    </linearGradient>
    <linearGradient id="cake2" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FDCEDF"/>
      <stop offset="100%" stop-color="#F2BED1"/>
    </linearGradient>
    <linearGradient id="cream" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#FFF0F5"/>
    </linearGradient>
    <linearGradient id="flame" x1="0%" y1="100%" x2="0%" y2="0%">
      <stop offset="0%" stop-color="#FF9EAA"/>
      <stop offset="50%" stop-color="#FFD93D"/>
      <stop offset="100%" stop-color="#FFF275"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#5A434A" flood-opacity="0.15"/>
    </filter>
  </defs>

  <!-- Glow Background -->
  <circle cx="200" cy="220" r="160" fill="url(#glow)"/>

  <!-- Cake Stand -->
  <ellipse cx="200" cy="340" rx="140" ry="16" fill="#F8E8EE" filter="url(#shadow)"/>
  <path d="M175 340 L165 375 L235 375 L225 340 Z" fill="#E8A9BD"/>
  <ellipse cx="200" cy="375" rx="55" ry="10" fill="#D988A1"/>

  <!-- Bottom Cake Tier -->
  <g filter="url(#shadow)">
    <rect x="90" y="240" width="220" height="90" rx="12" fill="url(#cake1)"/>
    <!-- Cream Drips Bottom -->
    <path d="M90 250 Q110 275 130 250 Q150 280 170 250 Q190 275 210 250 Q230 280 250 250 Q270 275 290 250 Q300 270 310 250 L310 240 L90 240 Z" fill="url(#cream)"/>
    <!-- Decorative Strawberries / Pearls -->
    <circle cx="120" cy="290" r="6" fill="#FF8BA7"/>
    <circle cx="160" cy="295" r="5" fill="#FFB4C8"/>
    <circle cx="200" cy="290" r="6" fill="#FF8BA7"/>
    <circle cx="240" cy="295" r="5" fill="#FFB4C8"/>
    <circle cx="280" cy="290" r="6" fill="#FF8BA7"/>
  </g>

  <!-- Top Cake Tier -->
  <g filter="url(#shadow)">
    <rect x="130" y="165" width="140" height="80" rx="10" fill="url(#cake2)"/>
    <!-- Cream Drips Top -->
    <path d="M130 175 Q145 195 160 175 Q175 200 190 175 Q205 200 220 175 Q235 195 250 175 Q260 190 270 175 L270 165 L130 165 Z" fill="url(#cream)"/>
    <!-- Cute Heart Decors -->
    <text x="175" y="225" font-size="22" fill="#FFFFFF" opacity="0.9">♡</text>
    <text x="210" y="225" font-size="22" fill="#FFFFFF" opacity="0.9">♡</text>
  </g>

  <!-- Cream Frosting Swirls -->
  <ellipse cx="150" cy="165" rx="14" ry="10" fill="#FFFFFF"/>
  <ellipse cx="180" cy="163" rx="14" ry="10" fill="#FFFFFF"/>
  <ellipse cx="200" cy="160" rx="16" ry="11" fill="#FFFFFF"/>
  <ellipse cx="220" cy="163" rx="14" ry="10" fill="#FFFFFF"/>
  <ellipse cx="250" cy="165" rx="14" ry="10" fill="#FFFFFF"/>

  <!-- Candle -->
  <rect x="194" y="105" width="12" height="55" rx="4" fill="#FFFFFF"/>
  <!-- Candle Stripes -->
  <path d="M194 118 L206 125 M194 133 L206 140 M194 148 L206 155" stroke="#F2BED1" stroke-width="3"/>
  <line x1="200" y1="105" x2="200" y2="92" stroke="#5A434A" stroke-width="2"/>

  <!-- Flame -->
  <ellipse cx="200" cy="78" rx="10" ry="16" fill="url(#flame)"/>
  <ellipse cx="200" cy="80" rx="5" ry="9" fill="#FFFBEB"/>

  <!-- Sparkles -->
  <text x="80" y="140" font-size="26" fill="#F2BED1">✨</text>
  <text x="300" y="130" font-size="28" fill="#F2BED1">💖</text>
  <text x="60" y="270" font-size="22" fill="#FFB4C8">🌸</text>
  <text x="325" y="280" font-size="24" fill="#FFB4C8">✨</text>
</svg>
